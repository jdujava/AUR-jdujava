# Maintainer: Jonas Dujava <jonas.dujava@gmail.com>

pkgname='waybar-jd-git'
_pkgname='waybar'
pkgver=0.15.0.r5417.g3d3f553f
epoch=1
pkgrel=1
pkgdesc='A Wayland bar with native Mango modules - custom build'
arch=('x86_64' 'aarch64')
_repo_prefix='github.com/jdujava'
_repo_name="${pkgname%-git}"
url="https://${_repo_prefix}/${_repo_name}"
source=("${_repo_name}::git+https://${_repo_prefix}/${_repo_name}#branch=desktop")
license=('MIT')
depends=('atkmm' 'cairo' 'cairomm' 'fmt' 'glib2' 'glibc' 'glibmm' 'gtk3'
         'gtk-layer-shell' 'gtkmm3' 'jsoncpp' 'libdbusmenu-glib' 'libdbusmenu-gtk3'
         'libgcc' 'libmpdclient' 'libnl' 'libpulse' 'libsigc++' 'libstdc++'
         'libxkbcommon' 'pango' 'pangomm' 'spdlog' 'systemd-libs' 'wayland')
makedepends=('git' 'meson' 'ninja' 'pkgconf' 'wayland-protocols' 'glib2-devel')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
backup=('etc/xdg/waybar/config.jsonc' 'etc/xdg/waybar/style.css')
options=('!debug' '!lto')
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_repo_name" || return
    if [[ $(git rev-parse --is-shallow-repository) != false ]]; then
        printf '%s\n' 'pkgver requires complete Git history' >&2
        return 1
    fi
    local version count commit
    version=$(sed -n "s/^[[:space:]]*version:[[:space:]]*'\([^']*\)'.*/\1/p" meson.build)
    [[ -n $version ]] || return 1
    count=$(git rev-list --count HEAD) || return
    commit=$(git rev-parse HEAD) || return
    printf '%s.r%s.g%.8s\n' "$version" "$count" "$commit"
}

build() {
    local reconfigure=()
    [[ ! -f "$srcdir/build/build.ninja" ]] || reconfigure=(--reconfigure)
    arch-meson "${reconfigure[@]}" "$srcdir/$_repo_name" "$srcdir/build" \
        --wrap-mode=nofallback --auto-features=disabled -Dmango=true -Dniri=false \
        -Dexperimental=false -Dlibudev=enabled -Drfkill=enabled -Dlibnl=enabled \
        -Dpulseaudio=enabled -Dmpd=enabled -Ddbusmenu-gtk=enabled
    meson compile -C "$srcdir/build"
}

package() {
    DESTDIR="$pkgdir" meson install -C "$srcdir/build" --no-rebuild
    ln -s waybar "$pkgdir/usr/bin/waybar-mango"
    install -Dm644 "$srcdir/$_repo_name/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
