pkgbase = fmenu-git
	pkgdesc = A fuzzy-selection dynamic menu and related scripts
	pkgver = r20.d38f2187
	pkgrel = 1
	epoch = 1
	url = https://github.com/jdujava/fmenu
	arch = any
	license = MIT
	makedepends = git
	makedepends = make
	depends = sh
	depends = zsh
	depends = fzf>=0.38
	depends = python
	depends = glib2
	depends = python-gobject
	optdepends = foot: Wayland menu terminal
	optdepends = wl-clipboard: Wayland clipboard copying
	optdepends = cliphist: Wayland clipboard history
	optdepends = wtype: type selections into Wayland applications
	optdepends = fd: file discovery in the file pickers
	optdepends = jq: Mango focus checks in the Wayland one-liner picker
	optdepends = dmenu: optional X11 menu fallback
	optdepends = xsel: optional X11 clipboard fallback
	optdepends = xdotool: for typing out selection to the terminal
	optdepends = gtk3: for gtk-launch used in fzfopen
	optdepends = libnotify: for notifications from the Wayland one-liner picker
	optdepends = man-db: for creating manpage index database used in mfzf
	optdepends = pass: password manager used in passfmenu
	optdepends = xclip: clipboard support for pass in passfmenu
	optdepends = clipmenu: for clipboard history accessed by clipfmenu
	optdepends = sdcv: utility for dictionaries used in fdict
	optdepends = translate-shell: interface for translations used in fdict
	provides = fmenu
	conflicts = fmenu
	source = fmenu::git+https://github.com/jdujava/fmenu
	sha256sums = SKIP

pkgname = fmenu-git
