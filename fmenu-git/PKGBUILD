# Maintainer: Jonas Dujava <jonas.dujava@gmail.com>

pkgname='fmenu-git'
_pkgname='fmenu'
pkgver=r20.d38f2187
epoch=1
pkgrel=1
pkgdesc='A fuzzy-selection dynamic menu and related scripts'
arch=('any')
_repo_prefix='github.com/jdujava'
_repo_name="${pkgname%-git}"
url="https://${_repo_prefix}/${_repo_name}"
source=("${_repo_name}::git+https://${_repo_prefix}/${_repo_name}")
license=('MIT')
depends=('sh' 'zsh' 'fzf>=0.38' 'python' 'glib2' 'python-gobject')  # fdict uses zsh; fzfopen uses Python/GIO
optdepends=(
    'foot: Wayland menu terminal'
    'wl-clipboard: Wayland clipboard copying'
    'cliphist: Wayland clipboard history'
    'wtype: type selections into Wayland applications'
    'fd: file discovery in the file pickers'
    'jq: Mango focus checks in the Wayland one-liner picker'
    'dmenu: optional X11 menu fallback'
    'xsel: optional X11 clipboard fallback'
    'xdotool: for typing out selection to the terminal'
    'gtk3: for gtk-launch used in fzfopen'
    'libnotify: for notifications from the Wayland one-liner picker'
    'man-db: for creating manpage index database used in mfzf'
    'pass: password manager used in passfmenu'
    'xclip: clipboard support for pass in passfmenu'
    'clipmenu: for clipboard history accessed by clipfmenu'
    'sdcv: utility for dictionaries used in fdict'
    'translate-shell: interface for translations used in fdict'
)
makedepends=('git' 'make')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_repo_name" || return
    if [[ $(git rev-parse --is-shallow-repository) != false ]]; then
        printf '%s\n' 'pkgver requires complete Git history' >&2
        return 1
    fi
    local count commit
    count=$(git rev-list --count HEAD) || return
    commit=$(git rev-parse HEAD) || return
    printf 'r%s.%.8s\n' "$count" "$commit"
}

check() {
    cd "$srcdir/$_repo_name" || return
    python3 -B -m unittest discover -s tests
}

package() {
    cd "$srcdir/${_repo_name}"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    install -m644 -D LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -m644 -D README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
